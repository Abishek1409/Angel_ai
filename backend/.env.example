DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Gemini API - Used ONLY for embeddings/vector retrieval (RAG pipeline)
GEMINI_API_KEY=AIza-your-gemini-api-key-here  # Get free key at https://makersuite.google.com/app/apikey
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Groq API - Primary LLM provider for chat response generation (fast inference hardware)
GROQ_API_KEY=gsk-your-groq-api-key-here  # Get free key at https://console.groq.com/
GROQ_MODEL=llama-3.3-70b-versatile  # Check https://console.groq.com/docs/models for current model names

# OpenRouter API - Fallback LLM provider with multiple free models (rotation for rate limit handling)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here  # Get free key at https://openrouter.ai/keys
OPENROUTER_FREE_MODELS=meta-llama/llama-3.1-8b-instruct:free,qwen/qwen-2.5-7b-instruct:free,mistralai/mistral-7b-instruct:free,x-ai/grok-beta:free

# Redis cache (optional - graceful fallback if unavailable)
REDIS_URL=redis://localhost:6379/0
